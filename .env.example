# Copia este archivo como `.env` y rellena los valores. NUNCA subas `.env` al repo.

# Base de datos
DATABASE_URL=postgresql://postgres@localhost:5432/samproject

# Publicación/replay de comentarios: configurar en el servidor antes de habilitarlos.
# CLAVES es un objeto JSON {"identificador":"64 caracteres hexadecimales"}.
# Cada valor debe generarse con un generador criptográfico (32 bytes aleatorios).
# Mantener claves anteriores mientras existan marcadores que dependan de ellas.
COMENTARIOS_HMAC_CLAVE_ACTIVA=
COMENTARIOS_HMAC_CLAVES=

# JWT - genera uno aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
# Expiración del token de acceso (p. ej. 12h, 1d)
JWT_EXPIRES_IN=12h

# Servidor
PORT=3000
# Orígenes CORS permitidos, separados por coma (en desarrollo se permiten)
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# SMTP (desarrollo: MailHog en localhost:1025 sin auth; producción: proveedor real)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SamProject <no-reply@samproject.local>

# Enlace base para el correo de recuperación de contraseña
FRONTEND_URL=samproject://reset

# Minutos de validez del token de recuperación (recomendado 30-60)
RESET_TOKEN_TTL_MINUTES=45

# Enlace base para el correo de invitaci�n a un espacio
INVITE_URL=samproject://invitar
