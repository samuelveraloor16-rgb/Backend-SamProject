# Copia este archivo como `.env` y rellena los valores. NUNCA subas `.env` al repo.

# Base de datos
DATABASE_URL=postgresql://postgres@localhost:5432/samproject

# JWT - genera uno aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
# Expiraci贸n del token de acceso (p. ej. 12h, 1d)
JWT_EXPIRES_IN=12h

# Servidor
PORT=3000
# Or铆genes CORS permitidos, separados por coma (en desarrollo se permiten)
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# SMTP (desarrollo: MailHog en localhost:1025 sin auth; producci贸n: proveedor real)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SamProject <no-reply@samproject.local>

# Enlace base para el correo de recuperaci贸n de contrase帽a
FRONTEND_URL=samproject://reset

# Minutos de validez del token de recuperaci贸n (recomendado 30-60)
RESET_TOKEN_TTL_MINUTES=45

# Enlace base para el correo de invitaci髇 a un espacio
INVITE_URL=samproject://invitar
