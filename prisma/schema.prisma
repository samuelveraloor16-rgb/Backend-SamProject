// SamProject - Schema inicial (Fase 1)
// PostgreSQL + Prisma. IDs cuid(). Fechas ISO 8601 en la API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolEspacio {
  ADMINISTRADOR
  MIEMBRO
}

enum TipoPreferenciaNotificacion {
  TAREA_ASIGNADA
  TAREA_POR_VENCER
  TAREA_VENCIDA
  COMENTARIO
  MENCION
}

/// RF21: matriz propia independiente. CHECK SQL protege MENCION.inApp.
model PreferenciaNotificacion {
  usuarioId String
  tipo TipoPreferenciaNotificacion
  inApp Boolean @default(false)
  correo Boolean @default(false)
  push Boolean @default(true)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tipo])
  @@map("preferencias_notificaciones")
}

enum EstadoTarea {
  PENDIENTE
  EN_CURSO
  HECHA
}

enum PrioridadTarea {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoNotificacion {
  TAREA_ASIGNADA
  TAREA_POR_VENCER
  TAREA_VENCIDA
  COMENTARIO
  MENCION
  INVITACION
  SISTEMA
}

/// RF-20: plataforma del dispositivo móvil registrado para push.
enum PlataformaDispositivo {
  ANDROID
  IOS
}

/// RF-20: estados de una fila del outbox push. «Vencida»/reintentos se calculan; no es estado editable.
enum EstadoPushOutbox {
  PENDIENTE
  ENVIADO
  FALLIDO
  DESCARTADO
}

model Usuario {
  id                String    @id @default(cuid())
  email             String    @unique
  nombre            String
  fotoUrl           String?
  passwordHash      String
  /// Versiona los tokens JWT: al incrementarlo, los tokens emitidos antes quedan inválidos (logout / cambio de contraseña).
  tokenVersion      Int       @default(0)
  /// HASH (sha256) del token de recuperación; nunca se persiste el token plano.
  resetTokenHash    String?
  resetTokenExpires DateTime?
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt

  membresias        Membresia[]
  tareasAsignadas   Tarea[]             @relation("Responsable")
  comentarios       Comentario[]
  adjuntos          Adjunto[]
  notificaciones    Notificacion[]
  registros         RegistroDeCambios[]
  proyectosMiembro  ProyectoMiembro[]
  invitacionesCreadas Invitacion[]      @relation("InvitadoPor")
  menciones         Mencion[]
  idempotencias     IdempotenciaComentario[]
  dispositivos      Dispositivo[]
  pushOutbox        PushOutbox[]

  preferenciasNotificaciones PreferenciaNotificacion[]

  @@map("usuarios")
}

model EspacioDeTrabajo {
  id              String   @id @default(cuid())
  nombre          String
  esPersonal      Boolean  @default(false)
  /// RF-08 / RF-32: el administrador del espacio puede desactivar el asistente de IA.
  asistenteActivo Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  membresias      Membresia[]
  proyectos       Proyecto[]
  etiquetas       Etiqueta[]
  invitaciones    Invitacion[]

  @@map("espacios_de_trabajo")
}

model Membresia {
  id        String     @id @default(cuid())
  usuarioId String
  espacioId String
  rol       RolEspacio @default(MIEMBRO)
  creadoEn  DateTime   @default(now())

  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  espacio   EspacioDeTrabajo @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, espacioId])
  @@index([espacioId])
  @@map("membresias")
}

/// RF-06: invitación por correo a un espacio. Se guarda HASH del token, nunca el token plano.
model Invitacion {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  email        String
  rol          RolEspacio @default(MIEMBRO)
  espacioId    String
  invitadoPorId String?
  expiraEn     DateTime
  aceptadaEn   DateTime?
  creadoEn     DateTime   @default(now())

  espacio      EspacioDeTrabajo @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  invitadoPor  Usuario?         @relation("InvitadoPor", fields: [invitadoPorId], references: [id], onDelete: SetNull)

  @@index([espacioId])
  @@index([email])
  @@map("invitaciones")
}

model Proyecto {
  id                 String    @id @default(cuid())
  nombre             String
  descripcion        String?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  archivado          Boolean   @default(false)
  esBandejaDeEntrada Boolean   @default(false)
  espacioId          String
  creadoEn           DateTime  @default(now())
  actualizadoEn      DateTime  @updatedAt
  /// Borrado lógico opcional: si se elimina, se rellena en vez de borrar el registro físicamente.
  eliminadoEn        DateTime?

  espacio            EspacioDeTrabajo @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  tareas             Tarea[]
  miembros           ProyectoMiembro[]

  @@index([espacioId])
  @@map("proyectos")
}

/// RF-10: miembros de un proyecto (además de los miembros del espacio).
model ProyectoMiembro {
  id         String   @id @default(cuid())
  proyectoId String
  usuarioId  String
  creadoEn   DateTime @default(now())

  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, usuarioId])
  @@map("proyecto_miembros")
}

model Tarea {
  id                String         @id @default(cuid())
  titulo            String
  descripcion       String?
  estado            EstadoTarea    @default(PENDIENTE)
  prioridad         PrioridadTarea @default(MEDIA)
  fechaLimite       DateTime?
  /// Se establece al pasar a HECHA; necesaria para el cálculo de ritmo (RF-22/RF-25).
  fechaFinalizacion DateTime?
  proyectoId        String
  responsableId     String?
  tareaPadreId      String?
  creadoEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt

  proyecto          Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  responsable       Usuario?       @relation("Responsable", fields: [responsableId], references: [id], onDelete: SetNull)
  tareaPadre        Tarea?         @relation("Subtareas", fields: [tareaPadreId], references: [id], onDelete: Cascade)
  subtareas         Tarea[]        @relation("Subtareas")
  etiquetas         TareaEtiqueta[]
  comentarios       Comentario[]
  adjuntos          Adjunto[]
  pushOutbox        PushOutbox[]
  avisos            Notificacion[]

  @@index([proyectoId, estado])
  @@index([responsableId])
  @@index([tareaPadreId])
  @@map("tareas")
}

model Etiqueta {
  id        String   @id @default(cuid())
  nombre    String
  color     String?
  espacioId String
  creadoEn  DateTime @default(now())

  espacio   EspacioDeTrabajo @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  tareas    TareaEtiqueta[]

  @@unique([nombre, espacioId])
  @@map("etiquetas")
}

model TareaEtiqueta {
  tareaId    String
  etiquetaId String

  tarea      Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([tareaId, etiquetaId])
  @@map("tarea_etiquetas")
}

model Comentario {
  id            String   @id @default(cuid())
  texto         String
  tareaId       String
  autorId       String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tarea         Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  autor         Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  menciones     Mencion[]
  notificaciones Notificacion[]
  idempotencias IdempotenciaComentario[]
  pushOutbox    PushOutbox[]

  @@index([tareaId])
  @@map("comentarios")
}

model Adjunto {
  id            String   @id @default(cuid())
  nombreArchivo String
  url           String
  mimeType      String?
  tamanoBytes   Int?
  tareaId       String
  subidoPorId   String
  creadoEn      DateTime @default(now())

  tarea         Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  subidoPor     Usuario  @relation(fields: [subidoPorId], references: [id], onDelete: Cascade)

  @@index([tareaId])
  @@map("adjuntos")
}

model Notificacion {
  id        String            @id @default(cuid())
  usuarioId String
  tipo      TipoNotificacion  @default(SISTEMA)
  titulo    String
  cuerpo    String?
  leida     Boolean           @default(false)
  datos     Json?
  creadoEn  DateTime          @default(now())
  comentarioId String?
  tareaId String?
  tarea Tarea? @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuario   Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  comentario Comentario?      @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@unique([comentarioId, usuarioId, tipo])
  @@map("notificaciones")
}

/// Identidad irreversible sin FK: nunca purgar junto al recurso o aviso.
model IdentidadAviso {
  digest String @id
  @@map("identidades_aviso")
}

model Mencion {
  comentarioId String
  usuarioId String
  posicion Int
  comentario Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@id([comentarioId, usuarioId])
  @@map("menciones")
}

model IdempotenciaComentario {
  usuarioId String
  clave String
  huella String
  generacion String?
  comentarioId String?
  expiraEn DateTime
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  comentario Comentario? @relation(fields: [comentarioId], references: [id], onDelete: SetNull)
  @@id([usuarioId, clave])
  @@index([expiraEn])
  @@map("idempotencias_comentario")
}

/// RF-34: historial de cambios, solo lectura para el AdminWeb.
model RegistroDeCambios {
  id        String   @id @default(cuid())
  entidad   String
  entidadId String
  accion    String
  detalle   Json?
  usuarioId String?
  creadoEn  DateTime @default(now())

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@map("registro_de_cambios")
}

/// RF-20 (§9.2): dispositivo móvil registrado para push. `tokenPush` es único en BD
/// y JAMÁS aparece en respuestas, logs ni errores.
model Dispositivo {
  id                   String                 @id @default(cuid())
  usuarioId            String
  plataforma           PlataformaDispositivo
  tokenPush            String                 @unique
  /// Versión de sesión (Usuario.tokenVersion) vigente al registrarse/refrescarse.
  /// El emisor la revalida en el instante de enviar (§9.7): si no coincide → DESCARTADO.
  tokenVersionVinculado Int
  creadoEn             DateTime               @default(now())
  actualizadoEn        DateTime               @updatedAt
  /// Diagnóstico: último envío exitoso a este dispositivo (opcional).
  ultimoEnvioEn        DateTime?
  /// Transferencia 2 pasos (§9.3): en BD solo el hash SHA-256 del código, TTL 5 min,
  /// un solo uso. Usarlo o generarlo otra vez lo invalida (se limpia al consumir).
  codigoTransferenciaHash     String?
  codigoTransferenciaExpiraEn DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos")
}

/// RF-20 (§9.4/§9.6): outbox de envíos push. La fila nace en la transacción del negocio
/// (asignación/comentarios) o en el escaneo de vencimientos;
/// el envío al proveedor ocurre SIEMPRE después del commit, con revalidación previa.
/// `claveUnica` es la garantía de dedup (una sola vez por evento).
model PushOutbox {
  id             String            @id @default(cuid())
  /// venc24:<tareaId>:<fechaLimiteISO> · vencfin:<tareaId>:<fechaLimiteISO> ·
  /// com:<comentarioId>:<usuarioId> · asig:<tareaId>:<uuid> (nunca NULL → la UNIQUE cubre todo).
  claveUnica     String            @unique
  usuarioId      String
  tipo           TipoNotificacion
  tareaId        String
  comentarioId   String?
  estado         EstadoPushOutbox  @default(PENDIENTE)
  intentos       Int               @default(0)
  /// Próxima oportunidad de envío (backoff exponencial acotado 1 min → 2 h).
  proximoIntentoEn DateTime       @default(now())
  /// Motivo técnico SANITIZADO: sin tokens, sin contenido de comentarios ni títulos.
  ultimoError    String?
  enviadoEn      DateTime?
  creadoEn       DateTime          @default(now())
  actualizadoEn  DateTime          @updatedAt

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarea      Tarea       @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  comentario Comentario? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@index([estado, proximoIntentoEn])
  @@index([usuarioId, estado])
  // Un comentario genera un solo push por destinatario, incluso si es responsable y mencionado.
  // Para comentarioId NULL la garantía de dedup es claveUnica (NOT NULL).
  @@unique([comentarioId, usuarioId])
  @@map("push_outbox")
}

/// RF20 incremento 3: diario técnico sin tokens/contenido. Conserva tickets aceptados
/// por generación de vínculo para no reenviarlos si otro dispositivo falla.
model PushIntento {
  id             String   @id @default(cuid())
  outboxId       String
  dispositivoId  String
  usuarioId      String
  vinculoEn      DateTime
  aceptado       Boolean  @default(false)
  rechazado      Boolean  @default(false)
  creadoEn       DateTime @default(now())

  @@index([usuarioId, creadoEn])
  @@index([outboxId, dispositivoId, vinculoEn, aceptado])
  @@map("push_intentos")
}
// RF21 correo: identidad mínima sin FK destructiva; no retención/purge automático.
model IdentidadCorreo {
  digest String @id @db.VarChar(64)
  @@map("identidades_correo")
}

model FronteraCorreo {
  id Int @id
  desde DateTime @db.Timestamptz(3)
  @@map("frontera_correo")
}

// Sin snapshot de dirección ni contenido privado. No se vincula con cascadas.
model CorreoOutbox {
  digest String @id @db.VarChar(64)
  usuarioId String
  tareaId String
  comentarioId String?
  tipo String
  ocurridoEn DateTime @db.Timestamptz(3)
  estado String @default("PENDIENTE")
  intentos Int @default(0)
  proximoIntentoEn DateTime @default(now()) @db.Timestamptz(3)
  generacion String?
  leaseHasta DateTime? @db.Timestamptz(3)
  @@index([estado, proximoIntentoEn])
  @@map("correo_outbox")
}
